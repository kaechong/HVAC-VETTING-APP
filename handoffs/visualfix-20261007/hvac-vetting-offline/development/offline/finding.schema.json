{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hvac-vetting:offline-finding:0.1",
  "title": "Offline synthetic Finding; not an engineering approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "checklist_id", "subcondition_id", "path", "jurisdiction", "classification", "description", "primary_evidence_id", "evidence_ids", "rule_id", "code_citation", "location", "severity", "suggested_action"],
  "properties": {
    "finding_id": {"$ref": "#/definitions/id"},
    "checklist_id": {"type": "string", "pattern": "^CHK-(0[1-9]|1[0-9]|2[0-4])$"},
    "subcondition_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "path": {"enum": ["A", "B", "C", "D"]},
    "jurisdiction": {"enum": ["MACAU", "IBC_NFPA"]},
    "classification": {"enum": ["violation_candidate", "advice", "missing_data", "unsupported", "norm_pending"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 8000},
    "primary_evidence_id": {"$ref": "#/definitions/id"},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
    "rule_id": {"$ref": "#/definitions/id"},
    "code_citation": {"type": "string", "minLength": 1, "maxLength": 4000},
    "location": {"type": "string", "minLength": 1, "maxLength": 1000},
    "severity": {"enum": ["Critical", "Major", "Minor"]},
    "suggested_action": {"type": "string", "maxLength": 4000}
  },
  "definitions": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}}
}
